FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/media-worker ./cmd/media-worker

FROM alpine:3.22
RUN apk add --no-cache ca-certificates ffmpeg font-noto
RUN addgroup -S media && adduser -S -G media media
WORKDIR /app
COPY --from=build /out/media-worker /usr/local/bin/media-worker
RUN mkdir -p /app/data && chown -R media:media /app
USER media
EXPOSE 18810
ENTRYPOINT ["media-worker"]
