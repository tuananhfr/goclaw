# GoClaw environment variables.
# Copy to .env and fill in values. For Docker Compose, do NOT use 'export' prefix.
#
# Auto-generated by prepare-env.sh: GOCLAW_GATEWAY_TOKEN, GOCLAW_ENCRYPTION_KEY.
# LLM provider API keys: configure via the web dashboard setup wizard.

# --- Gateway (required) ---
GOCLAW_GATEWAY_TOKEN=
GOCLAW_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- Tekshot Studio local OAuth bridge (optional) ---
# Used when Google redirects to a public GoClaw tunnel, then GoClaw forwards
# the browser back to a local Tekshot Drupal callback.
# TEKSHOT_GOOGLE_OAUTH_CALLBACK_TARGET=http://tekshot.localhost/api/tekshot-studio/google/callback

# --- Tekshot job workers (optional, default 1, clamped to 1..64) ---
# One worker = one concurrent tekshot job, and the pool is shared by every
# tekshot job type, so with 1 worker an interactive chat queues behind a
# research run that may take the full 12-minute job timeout. Bulk producers
# send a negative priority, so a draft batch does not block an interactive
# caller. Raise GOCLAW_MEM_LIMIT and GOCLAW_DB_MAX_OPEN_CONNS at the same
# time — worker count alone buys nothing.
# GOCLAW_TEKSHOT_JOB_WORKERS=4

# --- Container resource caps (optional; defaults match the compose files) ---
# Hard caps the kernel enforces. An OOM kills every in-flight job at once,
# so raise these together with the worker count, never after.
# GOCLAW_MEM_LIMIT=4G
# GOCLAW_CPU_LIMIT=2.0
# POSTGRES_MEM_LIMIT=4G
# POSTGRES_CPU_LIMIT=1.0

# --- Database (only for non-Docker deployments) ---
# Docker Compose auto-builds this from POSTGRES_USER/PASSWORD/DB.
# GOCLAW_POSTGRES_DSN=postgres://user:pass@host:5432/dbname?sslmode=disable
#
# Connection pool. An in-flight job borrows a connection per query, so a large
# worker count needs a larger pool. Keep max_open under the server's
# max_connections (100 by default).
# GOCLAW_DB_MAX_OPEN_CONNS=25
# GOCLAW_DB_MAX_IDLE_CONNS=10
#
# Interface the Postgres container publishes on. Loopback by default; set it
# to 0.0.0.0 ONLY on a host that is not reachable from the internet, because
# a published port bypasses ufw (Docker writes its own iptables rules).
# POSTGRES_BIND=127.0.0.1

# --- Sandbox (only when using docker-compose.sandbox.yml) ---
# Docker socket GID: 999 on Linux, 0 on Windows/macOS Docker Desktop.
# DOCKER_GID=0

# --- Debug ---
# GOCLAW_TRACE_VERBOSE=1
