# GoClaw environment variables.
# Copy to .env and fill in values. For Docker Compose, do NOT use 'export' prefix.
#
# Auto-generated by prepare-env.sh: GOCLAW_GATEWAY_TOKEN, GOCLAW_ENCRYPTION_KEY.
# LLM provider API keys: configure via the web dashboard setup wizard.

# --- Gateway (required) ---
GOCLAW_GATEWAY_TOKEN=
GOCLAW_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- Tekshot Studio local OAuth bridge (optional) ---
# Used when Google redirects to a public GoClaw tunnel, then GoClaw forwards
# the browser back to a local Tekshot Drupal callback.
# TEKSHOT_GOOGLE_OAUTH_CALLBACK_TARGET=http://tekshot.localhost/api/tekshot-studio/google/callback

# --- Tekshot job workers (optional, default 1, clamped to 1..8) ---
# One worker = one concurrent tekshot job. The pool is shared by draft_posts,
# post_chat, image_chat, market_research, content_checklist and
# competitor_discovery, so with 1 worker an interactive chat queues behind a
# research run that may take the full 12-minute job timeout.
# Raise the container memory limit in docker-compose.yml at the same time.
# GOCLAW_TEKSHOT_JOB_WORKERS=4

# --- Database (only for non-Docker deployments) ---
# Docker Compose auto-builds this from POSTGRES_USER/PASSWORD/DB.
# GOCLAW_POSTGRES_DSN=postgres://user:pass@host:5432/dbname?sslmode=disable

# --- Sandbox (only when using docker-compose.sandbox.yml) ---
# Docker socket GID: 999 on Linux, 0 on Windows/macOS Docker Desktop.
# DOCKER_GID=0

# --- Debug ---
# GOCLAW_TRACE_VERBOSE=1
