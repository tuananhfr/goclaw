# Facebook MCP Server - Environment Variables

# Server port (default: 3100)
PORT=3100

# Optional: Default Facebook credentials (used when no Authorization header is provided)
# FB_PAGE_ACCESS_TOKEN=your_page_access_token_here
# FB_PAGE_ID=your_page_id_here

# Facebook Graph API version (default: v25.0)
# FB_API_VERSION=v25.0

# Optional: used when watermark/logo assets are stored in GoClaw.
# In Docker Compose, this should be the GoClaw service URL on the Docker network,
# not a host path.
# GOCLAW_BASE_URL=http://goclaw:18790
# GOCLAW_GATEWAY_TOKEN=your_goclaw_gateway_token
